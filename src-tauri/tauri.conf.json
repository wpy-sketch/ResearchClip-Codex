{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ResearchClip",
  "version": "5.1.0",
  "identifier": "io.researchclip.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ResearchClip",
        "width": 1180,
        "height": 800,
        "minWidth": 480,
        "minHeight": 400,
        "center": true,
        "theme": "Dark",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": [
        "main-window",
        "capture-overlay",
        "desktop-pins",
        "scroll-control",
        "window-picker"
      ],
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "resources": {
      "../docs/licenses/flexlayout-react-MIT.txt": "licenses/flexlayout-react-MIT.txt",
      "../docs/licenses/remark-gfm-NOTICES.txt": "licenses/remark-gfm-NOTICES.txt",
      "../docs/licenses/lowlight-NOTICES.txt": "licenses/lowlight-NOTICES.txt",
      "../docs/licenses/pdfjs-NOTICES.txt": "licenses/pdfjs-NOTICES.txt",
      "../docs/licenses/httparse-LICENSE-MIT.txt": "licenses/httparse-LICENSE-MIT.txt",
      "resources/native/onnxruntime.dll": "native/onnxruntime.dll",
      "resources/native/LICENSE": "licenses/onnxruntime-MIT.txt",
      "resources/native/ThirdPartyNotices.txt": "licenses/onnxruntime-ThirdPartyNotices.txt",
      "../docs/licenses/step2-dependencies-NOTICES.txt": "licenses/step2-dependencies-NOTICES.txt",
      "../docs/licenses/PaddleOCR-Apache-2.0.txt": "licenses/PaddleOCR-Apache-2.0.txt",
      "../semantic-search/licenses/APACHE-2.0.txt": "licenses/semantic-APACHE-2.0.txt",
      "../semantic-search/licenses/CLIP-MIT.txt": "licenses/semantic-CLIP-MIT.txt",
      "../semantic-search/licenses/NOTICE.txt": "licenses/semantic-NOTICE.txt",
      "../browser-extension/LICENSE": "licenses/ResearchClip-clipper-MIT.txt",
      "../docs/licenses/webview2-com-MIT.txt": "licenses/webview2-com-MIT.txt"
    },
    "targets": [
      "nsis"
    ],
    "publisher": "ResearchClip",
    "category": "Productivity",
    "shortDescription": "Local research screenshots and knowledge cards",
    "longDescription": "Capture, annotate and organize research images and Markdown notes locally.",
    "useLocalToolsDir": true,
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installerHooks": "windows/installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [],
      "windows": {
        "installMode": "basicUi"
      },
      "requireSignedVersion": true
    }
  }
}
